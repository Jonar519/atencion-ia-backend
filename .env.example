# Copia este archivo como ".env" y ajusta los valores.
# En Windows (cmd.exe): copy .env.example .env

# --- Base de datos y Redis (docker-compose.yml de atencion-ia-database) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/atencion_ia
REDIS_URL=redis://localhost:6380

# --- Servidor ---
PORT=4100
NODE_ENV=development
# Nivel de logs de pino: fatal | error | warn | info | debug (en tests: silent)
LOG_LEVEL=info

# --- Autenticación del staff ---
# Firma de los access tokens (HS256). Mínimo 32 caracteres. En cmd.exe puedes generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_de_al_menos_32_caracteres
# Access token de corta vida (el navegador lo guarda SOLO en memoria).
JWT_EXPIRES_IN=15m
# Vida del refresh token (cookie httpOnly rotativa), en días.
REFRESH_TOKEN_TTL_DAYS=7
# Cookie "Secure" (solo HTTPS). Por defecto true en producción y false en local.
# COOKIE_SECURE=false

# --- Privacidad ---
# Secreto del HMAC con el que se guardan las IPs (audit_log, widget_sessions):
# nunca se guarda la IP en claro. Mínimo 32 caracteres, distinto de JWT_SECRET.
IP_HASH_SECRET=otro_valor_aleatorio_distinto_de_al_menos_32_caracteres

# --- Seguridad HTTP ---
# Orígenes permitidos por CORS, separados por coma. OBLIGATORIO en producción.
# (El frontend de este proyecto usa el puerto 5174 para convivir con el Proyecto 1.)
CORS_ORIGIN=http://localhost:5174
# Número de proxies delante de la API (0 en local, 1 detrás de un balanceador).
TRUST_PROXY=0
# SOLO pruebas de carga: multiplica todos los límites de rate limiting.
# Prohibido (el servidor no arranca) con NODE_ENV=production.
# RATE_LIMIT_SCALE=1

# --- Operación ---
# Token para leer GET /metrics con "Authorization: Bearer <token>".
# Vacío = métricas desactivadas (404).
METRICS_TOKEN=
# Tiempo máximo del apagado ordenado (SIGTERM / Ctrl+C) antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=10000
# Espera entre "/ready responde 503" y cerrar el servidor (para el balanceador).
# 0 en local; en producción, al menos el intervalo del health check.
SHUTDOWN_DRAIN_DELAY_MS=0
