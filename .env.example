# Copia este archivo como ".env" y ajusta los valores.
# En Windows (cmd.exe): copy .env.example .env

# --- Base de datos y Redis (docker-compose.yml de atencion-ia-database) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/atencion_ia
REDIS_URL=redis://localhost:6380

# --- Servidor ---
PORT=4100
NODE_ENV=development
# Nivel de logs de pino: fatal | error | warn | info | debug (en tests: silent)
LOG_LEVEL=info

# --- Autenticación del staff ---
# Firma de los access tokens (HS256). Mínimo 32 caracteres. En cmd.exe puedes generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_de_al_menos_32_caracteres
# Access token de corta vida (el navegador lo guarda SOLO en memoria).
JWT_EXPIRES_IN=15m
# Vida del refresh token (cookie httpOnly rotativa), en días.
REFRESH_TOKEN_TTL_DAYS=7
# Cookie "Secure" (solo HTTPS). Por defecto true en producción y false en local.
# COOKIE_SECURE=false

# --- Privacidad ---
# Secreto del HMAC con el que se guardan las IPs (audit_log, widget_sessions):
# nunca se guarda la IP en claro. Mínimo 32 caracteres, distinto de JWT_SECRET.
IP_HASH_SECRET=otro_valor_aleatorio_distinto_de_al_menos_32_caracteres

# --- Seguridad HTTP ---
# Orígenes permitidos por CORS, separados por coma. OBLIGATORIO en producción.
# (El frontend de este proyecto usa el puerto 5174 para convivir con el Proyecto 1.)
CORS_ORIGIN=http://localhost:5174
# Número de proxies delante de la API (0 en local, 1 detrás de un balanceador).
TRUST_PROXY=0
# SOLO pruebas de carga: multiplica todos los límites de rate limiting.
# Prohibido (el servidor no arranca) con NODE_ENV=production.
# RATE_LIMIT_SCALE=1

# --- Operación ---
# Token para leer GET /metrics con "Authorization: Bearer <token>".
# Vacío = métricas desactivadas (404).
METRICS_TOKEN=
# Tiempo máximo del apagado ordenado (SIGTERM / Ctrl+C) antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=10000
# Espera entre "/ready responde 503" y cerrar el servidor (para el balanceador).
# 0 en local; en producción, al menos el intervalo del health check.
SHUTDOWN_DRAIN_DELAY_MS=0

# --- Inteligencia artificial ---
# "mock" (por defecto): determinista, sin costo ni credenciales. Úsalo en desarrollo, tests,
# CI y pruebas de carga. PROHIBIDO con NODE_ENV=production (el servidor no arranca).
# "anthropic": Claude (respuestas e intención) + Voyage AI (embeddings). Exige ambas keys.
AI_PROVIDER=mock
# Consigue la key en https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=
# Consigue la key en https://dashboard.voyageai.com (API Keys)
VOYAGE_API_KEY=
# Modelos (valores por defecto recomendados; ver docs/adr/0005).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_CLASSIFIER_MODEL=claude-opus-5-5
# VOYAGE_MODEL=voyage-3.5
# Tiempo máximo por llamada al proveedor (ms).
AI_TIMEOUT_MS=20000
# Solo con AI_PROVIDER=mock: latencia artificial por llamada (pruebas de carga).
AI_MOCK_LATENCY_MS=0
# RAG: fragmentos por respuesta y similitud mínima. Sin RAG_MIN_SCORE se usa 0.2 (mock)
# o 0.45 (Voyage, SIN CALIBRAR todavía: correr `npm run rag:calibrate` con la key real).
RAG_TOP_K=4
# RAG_MIN_SCORE=
# Tope diario de tokens de IA por cliente (defensa contra agotar créditos).
AI_DAILY_TOKEN_BUDGET_PER_CUSTOMER=60000

# --- Widget del cliente ---
WIDGET_SESSION_TTL_HOURS=24

# --- Worker (npm run worker) ---
WORKER_CONCURRENCY=2
# Puerto de /health y /metrics del worker (métricas con el mismo METRICS_TOKEN).
WORKER_METRICS_PORT=9465

# --- Voz (Fase 5; ver docs/privacy-voice.md y docs/adr/0010, 0011) ---
# "mock" (por defecto): transcripción y síntesis simuladas, sin costo ni credenciales.
# PROHIBIDO con NODE_ENV=production. "deepgram": STT Nova-3 + TTS Aura-2 (exige la key).
VOICE_PROVIDER=mock
# Consigue la key en https://console.deepgram.com (proyecto → API Keys, rol de uso)
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_LANGUAGE=es
# DEEPGRAM_TTS_MODEL=aura-2-celeste-es
VOICE_TIMEOUT_MS=15000
# Días que se conserva la transcripción (1-180; la base impone el máximo).
VOICE_TRANSCRIPT_RETENTION_DAYS=90
VOICE_MAX_CALL_SECONDS=900
# Segundos de audio por cliente en 24 h (defensa contra agotar créditos de STT).
VOICE_DAILY_SECONDS_PER_CUSTOMER=1800
VOICE_RECONNECT_GRACE_MS=15000
VOICE_CONNECT_TIMEOUT_MS=30000
# STUN/TURN para WebRTC entre cliente y agente, como JSON. Vacío = solo misma red.
# Ejemplo: [{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"u","credential":"c"}]
ICE_SERVERS=[]
