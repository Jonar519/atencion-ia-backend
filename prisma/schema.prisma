generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

model StaffUser {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String            @db.VarChar(150)
  email                  String            @unique(map: "uq_staff_users_email") @db.VarChar(254)
  /// NULL = invitación pendiente (migración 018): la cuenta aún no tiene contraseña y no puede entrar.
  passwordHash           String?           @map("password_hash") @db.VarChar(255)
  role                   StaffRole         @default(agent)
  availability           AgentAvailability @default(offline)
  maxConcurrent          Int               @default(3) @map("max_concurrent") @db.SmallInt
  isActive               Boolean           @default(true) @map("is_active")
  lastLoginAt            DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  phone                  String?           @db.VarChar(30)
  avatarStorageKey       String?           @map("avatar_storage_key") @db.VarChar(300)
  /// Secreto TOTP CIFRADO (AES-256-GCM, src/modules/auth/mfaCrypto.ts). Nunca en claro.
  mfaSecretEncrypted     String?           @map("mfa_secret_encrypted")
  mfaEnabledAt           DateTime?         @map("mfa_enabled_at") @db.Timestamptz(6)
  mfaLastUsedStep        BigInt?           @map("mfa_last_used_step")
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)
  /// Invitación (migración 018): cuándo y quién invitó; cuándo la persona completó su cuenta.
  invitedAt              DateTime?         @map("invited_at") @db.Timestamptz(6)
  invitedById            String?           @map("invited_by") @db.Uuid
  activatedAt            DateTime?         @map("activated_at") @db.Timestamptz(6)
  invitedBy              StaffUser?        @relation("staff_invited_by", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invitedStaff           StaffUser[]       @relation("staff_invited_by")
  callParticipations     CallParticipant[]
  handledCalls           Call[]
  assignedConversations  Conversation[]
  outboxEmails           EmailOutbox[]
  assignedEscalations    Escalation[]
  createdArticles        KbArticle[]       @relation("kb_articles_created_byTostaff_users")
  updatedArticles        KbArticle[]       @relation("kb_articles_updated_byTostaff_users")
  sentMessages           Message[]
  mfaBackupCodes         MfaBackupCode[]
  refreshTokens          RefreshToken[]
  tokens                 StaffToken[]
  createdCannedResponses CannedResponse[]  @relation("canned_created_by")
  updatedCannedResponses CannedResponse[]  @relation("canned_updated_by")

  @@map("staff_users")
}

model RefreshToken {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId   String         @map("staff_user_id") @db.Uuid
  familyId      String         @map("family_id") @db.Uuid
  tokenHash     String         @unique(map: "uq_refresh_tokens_hash") @map("token_hash") @db.Char(64)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  /// rotated | logout | reuse_detected | expired (CHECK en la base)
  revokeReason  String?        @map("revoke_reason") @db.VarChar(30)
  replacedById  String?        @map("replaced_by") @db.Uuid
  userAgent     String?        @map("user_agent") @db.VarChar(200)
  /// IP TRUNCADA (x.y.z.0 o /48), nunca la completa (CHECK en la base).
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  locationLabel String?        @map("location_label") @db.VarChar(120)
  replacedBy    RefreshToken?  @relation("refresh_tokensTorefresh_tokens", fields: [replacedById], references: [id], onUpdate: NoAction)
  replaces      RefreshToken[] @relation("refresh_tokensTorefresh_tokens")
  staffUser     StaffUser      @relation(fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([staffUserId], map: "idx_refresh_tokens_staff_user")
  @@map("refresh_tokens")
}

model LoginAttempt {
  keyHash     String    @id @map("key_hash") @db.Char(64)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailure DateTime  @default(now()) @map("last_failure") @db.Timestamptz(6)

  @@index([lastFailure], map: "idx_login_attempts_last_failure")
  @@map("login_attempts")
}

model Customer {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName    String?         @map("display_name") @db.VarChar(120)
  email          String?         @db.VarChar(254)
  phone          String?         @db.VarChar(16)
  externalRef    String?         @map("external_ref") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  aiUsage        AiUsage[]
  conversations  Conversation[]
  widgetSessions WidgetSession[]

  @@map("customers")
}

model WidgetSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique(map: "uq_widget_sessions_token") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.VarChar(200)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId, createdAt(sort: Desc)], map: "idx_widget_sessions_customer")
  @@index([expiresAt], map: "idx_widget_sessions_expires")
  @@map("widget_sessions")
}

model Conversation {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String                   @map("customer_id") @db.Uuid
  assignedAgentId String?                  @map("assigned_agent_id") @db.Uuid
  status          ConversationStatus       @default(ai_active)
  originChannel   ChannelType              @map("origin_channel")
  subject         String?                  @db.VarChar(200)
  priority        Int                      @default(0) @db.SmallInt
  lastMessageAt   DateTime                 @default(now()) @map("last_message_at") @db.Timestamptz(6)
  closedAt        DateTime?                @map("closed_at") @db.Timestamptz(6)
  closeReason     ConversationCloseReason? @map("close_reason")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  aiUsage         AiUsage[]
  calls           Call[]
  assignedAgent   StaffUser?               @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  escalations     Escalation[]
  messages        Message[]

  @@index([assignedAgentId, status, lastMessageAt(sort: Desc)], map: "idx_conversations_agent")
  @@index([customerId, createdAt(sort: Desc)], map: "idx_conversations_customer")
  @@index([status, lastMessageAt(sort: Desc)], map: "idx_conversations_status_last")
  @@map("conversations")
}

model Message {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId       String                  @map("conversation_id") @db.Uuid
  senderType           SenderType              @map("sender_type")
  senderAgentId        String?                 @map("sender_agent_id") @db.Uuid
  channel              ChannelType             @default(text)
  callId               String?                 @map("call_id") @db.Uuid
  content              String
  intent               MessageIntent?
  sentiment            MessageSentiment?
  analysisConfidence   Float?                  @map("analysis_confidence") @db.Real
  clientMsgId          String?                 @map("client_msg_id") @db.Uuid
  aiModel              String?                 @map("ai_model") @db.VarChar(80)
  aiLatencyMs          Int?                    @map("ai_latency_ms")
  createdAt            DateTime                @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  /// En la base message_id es UNIQUE (un turno = un segmento); Prisma lo modela como lista por la FK compuesta (014).
  transcriptSegments   CallTranscriptSegment[]
  triggeredEscalations Escalation[]
  citations            MessageCitation[]
  /// Adjunto (imagen o PDF), a lo sumo UNO: la base lo impone (UNIQUE message_id, 017); Prisma lo modela como lista por la FK compuesta.
  attachments          MessageAttachment[]
  call                 Call?                   @relation(fields: [callId, conversationId], references: [id, conversationId], onDelete: NoAction, onUpdate: NoAction, map: "fk_messages_call")
  conversation         Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  senderAgent          StaffUser?              @relation(fields: [senderAgentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([conversationId, clientMsgId], map: "uq_messages_client_msg")
  @@unique([id, conversationId], map: "uq_messages_id_conversation")
  @@unique([id, callId], map: "uq_messages_id_call")
  @@index([conversationId, createdAt, id], map: "idx_messages_conversation")
  @@map("messages")
}

model MessageCitation {
  messageId      String     @map("message_id") @db.Uuid
  rank           Int        @db.SmallInt
  articleId      String?    @map("article_id") @db.Uuid
  chunkId        String?    @map("chunk_id") @db.Uuid
  articleVersion Int        @map("article_version")
  score          Float      @db.Real
  article        KbArticle? @relation(fields: [articleId], references: [id], onUpdate: NoAction)
  chunk          KbChunk?   @relation(fields: [chunkId], references: [id], onUpdate: NoAction)
  message        Message    @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([messageId, rank])
  @@map("message_citations")
}

model Escalation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId      String            @map("conversation_id") @db.Uuid
  callId              String?           @map("call_id") @db.Uuid
  triggeringMessageId String?           @map("triggering_message_id") @db.Uuid
  triggerSource       EscalationTrigger @map("trigger_source")
  reason              EscalationReason
  signal              Json              @default("{}")
  priority            Int               @default(50) @db.SmallInt
  status              EscalationStatus  @default(open)
  assignedAgentId     String?           @map("assigned_agent_id") @db.Uuid
  assignedAt          DateTime?         @map("assigned_at") @db.Timestamptz(6)
  resolvedAt          DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolutionNote      String?           @map("resolution_note") @db.VarChar(500)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignedAgent       StaffUser?        @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversation        Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  call                Call?             @relation(fields: [callId, conversationId], references: [id, conversationId], onDelete: NoAction, onUpdate: NoAction, map: "fk_escalations_call")
  triggeringMessage   Message?          @relation(fields: [triggeringMessageId, conversationId], references: [id, conversationId], onDelete: NoAction, onUpdate: NoAction, map: "fk_escalations_message")

  @@index([conversationId, createdAt(sort: Desc)], map: "idx_escalations_conversation")
  @@map("escalations")
}

model Call {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId     String                  @map("conversation_id") @db.Uuid
  status             CallStatus              @default(connecting)
  consentGivenAt     DateTime                @map("consent_given_at") @db.Timestamptz(6)
  consentVersion     String                  @map("consent_version") @db.VarChar(20)
  startedAt          DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  answeredAt         DateTime?               @map("answered_at") @db.Timestamptz(6)
  endedAt            DateTime?               @map("ended_at") @db.Timestamptz(6)
  /// Columna CALCULADA en la base (GENERATED ALWAYS … STORED): solo lectura, nunca escribirla.
  durationSeconds    Int?                    @default(dbgenerated("\nCASE\n    WHEN ((answered_at IS NOT NULL) AND (ended_at IS NOT NULL)) THEN (EXTRACT(epoch FROM (ended_at - answered_at)))::integer\n    ELSE NULL::integer\nEND")) @map("duration_seconds")
  handledByAgentId   String?                 @map("handled_by_agent_id") @db.Uuid
  endReason          CallEndReason?          @map("end_reason")
  sttProvider        String                  @map("stt_provider") @db.VarChar(40)
  ttsProvider        String                  @map("tts_provider") @db.VarChar(40)
  audioStorageKey    String?                 @map("audio_storage_key") @db.VarChar(500)
  retainUntil        DateTime                @map("retain_until") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  transcriptPurgedAt DateTime?               @map("transcript_purged_at") @db.Timestamptz(6)
  aiUsage            AiUsage[]
  participants       CallParticipant[]
  transcriptSegments CallTranscriptSegment[]
  conversation       Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  handledByAgent     StaffUser?              @relation(fields: [handledByAgentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  escalations        Escalation[]
  messages           Message[]

  @@unique([id, conversationId], map: "uq_calls_id_conversation")
  @@index([conversationId, startedAt(sort: Desc)], map: "idx_calls_conversation")
  @@index([retainUntil], map: "idx_calls_retain_until")
  @@map("calls")
}

model CallParticipant {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId          String          @map("call_id") @db.Uuid
  participantType ParticipantType @map("participant_type")
  agentId         String?         @map("agent_id") @db.Uuid
  joinedAt        DateTime        @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?       @map("left_at") @db.Timestamptz(6)
  agent           StaffUser?      @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  call            Call            @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([callId, joinedAt], map: "idx_call_participants_call")
  @@map("call_participants")
}

model CallTranscriptSegment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId     String          @map("call_id") @db.Uuid
  seq        Int
  speaker    ParticipantType
  text       String
  startMs    Int             @map("start_ms")
  endMs      Int             @map("end_ms")
  confidence Float?          @db.Real
  messageId  String?         @unique(map: "uq_call_transcript_segments_message") @map("message_id") @db.Uuid
  createdAt  DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  call       Call            @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message    Message?        @relation(fields: [messageId, callId], references: [id, callId], onDelete: SetNull, onUpdate: NoAction, map: "fk_call_transcript_segments_message_same_call")

  @@unique([callId, seq], map: "uq_call_transcript_segments_seq")
  @@map("call_transcript_segments")
}

model KbArticle {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String            @unique(map: "uq_kb_articles_slug") @db.VarChar(120)
  title       String            @db.VarChar(200)
  body        String
  category    String            @db.VarChar(60)
  tags        String[]          @default([])
  status      KbArticleStatus   @default(draft)
  version     Int               @default(1)
  createdById String?           @map("created_by") @db.Uuid
  updatedById String?           @map("updated_by") @db.Uuid
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   StaffUser?        @relation("kb_articles_created_byTostaff_users", fields: [createdById], references: [id], onUpdate: NoAction)
  updatedBy   StaffUser?        @relation("kb_articles_updated_byTostaff_users", fields: [updatedById], references: [id], onUpdate: NoAction)
  chunks      KbChunk[]
  citations   MessageCitation[]

  @@index([status, category, updatedAt(sort: Desc)], map: "idx_kb_articles_status_category")
  @@index([tags], map: "idx_kb_articles_tags", type: Gin)
  @@map("kb_articles")
}

/// El embedding (vector(1024)) no lo soporta Prisma: se escribe y se busca con SQL crudo.
model KbChunk {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId      String                @map("article_id") @db.Uuid
  articleVersion Int                   @map("article_version")
  chunkIndex     Int                   @map("chunk_index")
  content        String
  contentSha256  String                @map("content_sha256") @db.Char(64)
  embedding      Unsupported("vector")
  embeddingModel String                @map("embedding_model") @db.VarChar(80)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  article        KbArticle             @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  citations      MessageCitation[]

  @@unique([articleId, chunkIndex, embeddingModel], map: "uq_kb_chunks_article_chunk_model")
  @@index([embedding], map: "idx_kb_chunks_embedding")
  @@map("kb_chunks")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(60)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  metadata   Json      @default("{}")
  ipHash     String?   @map("ip_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorType, actorId, createdAt(sort: Desc)], map: "idx_audit_log_actor")
  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created")
  @@index([entityType, entityId], map: "idx_audit_log_entity")
  @@map("audit_log")
}

model AiUsage {
  id               BigInt        @id @default(autoincrement())
  kind             AiUsageKind
  provider         String        @db.VarChar(40)
  model            String?       @db.VarChar(80)
  conversationId   String?       @map("conversation_id") @db.Uuid
  customerId       String?       @map("customer_id") @db.Uuid
  callId           String?       @map("call_id") @db.Uuid
  /// tokens | seconds | characters (CHECK en la base)
  unit             String        @db.VarChar(20)
  inputUnits       Int           @default(0) @map("input_units")
  outputUnits      Int           @default(0) @map("output_units")
  estimatedCostUsd Decimal       @default(0) @map("estimated_cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  call             Call?         @relation(fields: [callId], references: [id], onUpdate: NoAction)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onUpdate: NoAction)
  customer         Customer?     @relation(fields: [customerId], references: [id], onUpdate: NoAction)

  @@index([createdAt, kind], map: "idx_ai_usage_created_kind")
  @@map("ai_usage")
}

model SchemaMigration {
  filename  String   @id @db.VarChar(255)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EmailOutbox {
  id             BigInt     @id @default(autoincrement())
  toAddress      String     @map("to_address") @db.VarChar(254)
  subject        String     @db.VarChar(200)
  bodyText       String     @map("body_text")
  template       String     @db.VarChar(40)
  relatedStaffId String?    @map("related_staff_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  relatedStaff   StaffUser? @relation(fields: [relatedStaffId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_email_outbox_created")
  @@map("email_outbox")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MfaBackupCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staffUserId, codeHash], map: "uq_mfa_backup_codes")
  @@map("mfa_backup_codes")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Tokens de UN SOLO USO (recuperación, cambio de correo, desafío y enrolamiento de MFA).
/// La base impone a lo sumo UNO sin usar por propósito y persona (índice único parcial).
model StaffToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  purpose     String    @db.VarChar(20)
  tokenHash   String    @unique(map: "uq_staff_tokens_hash") @map("token_hash") @db.Char(64)
  newEmail    String?   @map("new_email") @db.VarChar(254)
  attempts    Int       @default(0) @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_staff_tokens_expires")
  @@map("staff_tokens")
}

enum ActorType {
  staff
  customer
  system

  @@map("actor_type")
}

enum AgentAvailability {
  offline
  available
  busy
  away

  @@map("agent_availability")
}

enum AiUsageKind {
  chat
  classification
  embedding
  stt
  tts

  @@map("ai_usage_kind")
}

enum CallEndReason {
  customer_hangup
  agent_hangup
  timeout
  error
  transferred

  @@map("call_end_reason")
}

enum CallStatus {
  connecting
  in_progress
  waiting_agent
  ended
  failed

  @@map("call_status")
}

enum ChannelType {
  text
  voice

  @@map("channel_type")
}

