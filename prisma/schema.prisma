/// Respuestas predefinidas del panel (migración 016). Marcadores {cliente} y {asesor}: los reemplaza el navegador.
model CannedResponse {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String     @db.VarChar(80)
  body      String
  shortcut  String?    @db.VarChar(30)
  isActive  Boolean    @default(true) @map("is_active")
  createdBy String?    @map("created_by") @db.Uuid
  updatedBy String?    @map("updated_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator   StaffUser? @relation("canned_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updater   StaffUser? @relation("canned_updated_by", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("canned_responses")
}

/// Adjunto del chat (migración 017). El archivo vive en el almacenamiento; original_name es solo para
/// mostrarlo y NUNCA se envía a la IA (lo controla quien sube el archivo).
model MessageAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String   @unique(map: "uq_message_attachments_message") @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  storageKey     String   @unique @map("storage_key") @db.VarChar(300)
  contentType    String   @map("content_type") @db.VarChar(40)
  sizeBytes      Int      @map("size_bytes")
  originalName   String   @map("original_name") @db.VarChar(150)
  sha256         String   @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message        Message  @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_attachments_message")

  @@index([conversationId], map: "idx_message_attachments_conversation")
  @@map("message_attachments")
}

/// Archivos por borrar del almacenamiento (los encola un trigger al borrar un adjunto).
model StorageDeletion {
  storageKey  String   @id @map("storage_key") @db.VarChar(300)
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)

  @@map("storage_deletions")
}
